{
  "name": "mmm-mastodon",
  "version": "0.1.1",
  "description": "Bring Mastodon to your MagicMirror²: Display timelines, hashtags, and profiles with media thumbnails, QR codes, and rotating posts.",
  "keywords": [
    "MagicMirror",
    "MagicMirror²",
    "Mastodon",
    "Fediverse",
    "Social Media",
    "News"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/KristjanESPERANTO/MMM-Mastodon"
  },
  "license": "MIT",
  "author": {
    "name": "Kristjan ESPERANTO",
    "url": "https://github.com/KristjanESPERANTO"
  },
  "type": "commonjs",
  "scripts": {
    "lint": "eslint && prettier . --check",
    "lint:fix": "eslint --fix && prettier . --write",
    "release": "commit-and-tag-version --config ./changelog.config.js",
    "test": "node --run lint && node --run test:spelling",
    "test:spelling": "cspell ."
  },
  "main": "MMM-Mastodon.js",
  "dependencies": {
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@eslint/css": "^0.14.1",

    "@eslint/markdown": "^7.5.1",
    "commit-and-tag-version": "^12.6.1",
    "cspell": "^9.7.0",
    "eslint": "^10.0.2",
    "globals": "^17.4.0",
    "prettier": "^3.8.1"
  }
}
